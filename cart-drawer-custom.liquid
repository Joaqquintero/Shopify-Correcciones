<!-- LÓGICA DE JAVASCRIPT PRINCIPAL (PARSER PDF + DRAFT ORDER + WHATSAPP) -->
<script>
document.addEventListener('DOMContentLoaded', function () {
  if (typeof pdfjsLib !== 'undefined') {
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  }

  // CONFIGURACIÓN DE ENDPOINTS Y CONTACTO
  const CONFIG = {
    WORKER_URL: 'https://YOUR_WORKER_ENDPOINT.workers.dev', // Cambiar por endpoint privado
    WHATSAPP_NUMBER: '1234567890', // Número de WhatsApp de destino (anonimizado)
    SUPPORT_EMAIL: 'soporte@example.com'
  };

  const modal = document.getElementById('CartOrderModal');
  const modalClose = document.getElementById('CartOrderModalClose');
  const modalOverlay = modal ? modal.querySelector('.cart-order-modal__overlay') : null;
  const checkoutButton = document.getElementById('CartDrawer-Checkout');
  const showroomButton = document.getElementById('CartDrawer-Showroom');
  const form = document.getElementById('CartOrderForm');
  const shippingFields = document.getElementById('ShippingFields');
  const fiscalFields = document.getElementById('FiscalFields');
  const errorBox = document.getElementById('CartOrderError');
  const submitButton = document.getElementById('CartOrderSubmit');

  let orderType = 'shipping';
  let extractedFiscalData = null;

  const fiscalPDF = document.getElementById('FiscalPDF');
  if (fiscalPDF) {
    fiscalPDF.addEventListener('change', async function () {
      const file = this.files[0];
      if (!file) { extractedFiscalData = null; return; }
      if (file.type !== 'application/pdf') {
        extractedFiscalData = null;
        this.value = '';
        showError('El archivo debe estar en formato PDF.');
        return;
      }

      try {
        extractedFiscalData = null;
        const arrayBuffer = await file.arrayBuffer();
        const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
        let fullText = '';

        for (let i = 1; i <= pdf.numPages; i++) {
          const page = await pdf.getPage(i);
          const textContent = await page.getTextContent();
          fullText += textContent.items.map(item => item.str).join(' ') + '\n';
        }

        const text = fullText.replace(/\s+/g, ' ').trim();

        // Extracción de datos SAT mediante Expresiones Regulares
        const rfcMatch = text.match(/\b([A-ZÑ&]{3,4}\d{6}[A-Z0-9]{3})\b/i);
        const rfc = rfcMatch ? rfcMatch[1].toUpperCase() : '';

        let fiscalPostalCode = '';
        const postalCodeMatch = text.match(/Código\s*Postal\s*[:\-]?\s*(\d{5})/i);
        if (postalCodeMatch) fiscalPostalCode = postalCodeMatch[1];

        let fiscalName = '';
        const namePatterns = [
          /Denominaci[oó]n\/Raz[oó]n\s*Social\s*[:\-]?\s*(.+?)(?=\s+R[eé]gimen|\s+Nombre\s+Comercial|\s+C[oó]digo\s+Postal|\s+RFC|$)/i,
          /Denominaci[oó]n\s+o\s+Raz[oó]n\s+Social\s*[:\-]?\s*(.+?)(?=\s+R[eé]gimen|\s+Nombre\s+Comercial|\s+C[oó]digo\s+Postal|\s+RFC|$)/i
        ];
        for (const pattern of namePatterns) {
          const match = text.match(pattern);
          if (match) { fiscalName = match[1].trim(); break; }
        }

        let fiscalRegime = '';
        const regimePatterns = [
          /R[eé]gimen\s+Fiscal\s*[:\-]?\s*(.+?)(?=\s+Nombre\s+Comercial|\s+C[oó]digo\s+Postal|\s+RFC|$)/i,
          /R[eé]gimen\s*[:\-]?\s*(.+?)(?=\s+Nombre\s+Comercial|\s+C[oó]digo\s+Postal|\s+RFC|$)/i
        ];
        for (const pattern of regimePatterns) {
          const match = text.match(pattern);
          if (match) { fiscalRegime = match[1].trim(); break; }
        }

        extractedFiscalData = { rfc, fiscalName, fiscalPostalCode, fiscalRegime };

        document.getElementById('FiscalRFCPreview').textContent = rfc || 'No detectado';
        document.getElementById('FiscalNamePreview').textContent = fiscalName || 'No detectado';
        document.getElementById('FiscalPostalCodePreview').textContent = fiscalPostalCode || 'No detectado';
        document.getElementById('FiscalRegimePreview').textContent = fiscalRegime || 'No detectado';
        document.getElementById('FiscalExtractedData').hidden = false;

        if (!rfc || !fiscalName || !fiscalPostalCode || !fiscalRegime) {
          extractedFiscalData = null;
          showError(`No se pudieron extraer todos los datos automáticamente. Si es escaneo o foto, envíalo a ${CONFIG.SUPPORT_EMAIL}`);
          return;
        }

        errorBox.hidden = true;
      } catch (error) {
        console.error('Error procesando el PDF:', error);
        extractedFiscalData = null;
        showError('Error leyendo el PDF. Asegúrate de que no sea una imagen escaneada.');
      }
    });
  }

  function openOrderModal(type) {
    orderType = type;
    if (!modal) return;
    if (type === 'shipping') {
      shippingFields.hidden = false;
      document.getElementById('CartOrderModalTitle').textContent = 'Cotiza tu envío';
      setShippingRequired(true);
    } else {
      shippingFields.hidden = true;
      document.getElementById('CartOrderModalTitle').textContent = 'Retiro en Tienda';
      setShippingRequired(false);
    }
    errorBox.hidden = true;
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeOrderModal() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function setShippingRequired(required) {
    const fields = ['OrderFullName', 'OrderPhone', 'OrderEmail', 'OrderStreet', 'OrderExteriorNumber', 'OrderColonia', 'OrderPostalCode', 'OrderMunicipality', 'OrderState'];
    fields.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.required = required;
    });
  }

  if (checkoutButton) checkoutButton.addEventListener('click', e => { e.preventDefault(); openOrderModal('shipping'); });
  if (showroomButton) showroomButton.addEventListener('click', e => { e.preventDefault(); openOrderModal('showroom'); });
  if (modalClose) modalClose.addEventListener('click', closeOrderModal);
  if (modalOverlay) modalOverlay.addEventListener('click', closeOrderModal);

  const invoiceRadios = document.querySelectorAll('input[name="requires_invoice"]');
  invoiceRadios.forEach(radio => {
    radio.addEventListener('change', function () {
      const isYes = this.value === 'yes';
      fiscalFields.hidden = !isYes;
      ['FiscalPDF', 'FiscalCFDI', 'FiscalEmail', 'FiscalConfirmation'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.required = isYes;
      });
    });
  });

  function showError(msg) {
    errorBox.textContent = msg;
    errorBox.hidden = false;
    errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function formatMoney(val) {
    return '$' + (val / 100).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  async function sendToWhatsApp() {
    const response = await fetch('/cart.js');
    if (!response.ok) throw new Error('No se pudo obtener la información del carrito.');
    const cart = await response.json();
    if (!cart.items || cart.items.length === 0) throw new Error('El carrito está vacío.');

    const draftCart = {
      ...cart,
      items: cart.items.map(item => ({
        ...item,
        merchandise_id: `gid://shopify/ProductVariant/${item.variant_id}`
      }))
    };

    const shippingData = orderType === 'shipping' ? {
      fullName: document.getElementById('OrderFullName').value.trim(),
      phone: document.getElementById('OrderPhone').value.trim(),
      email: document.getElementById('OrderEmail').value.trim(),
      street: document.getElementById('OrderStreet').value.trim(),
      exteriorNumber: document.getElementById('OrderExteriorNumber').value.trim(),
      interiorNumber: document.getElementById('OrderInteriorNumber').value.trim(),
      colonia: document.getElementById('OrderColonia').value.trim(),
      postalCode: document.getElementById('OrderPostalCode').value.trim(),
      municipality: document.getElementById('OrderMunicipality').value.trim(),
      state: document.getElementById('OrderState').value.trim(),
      country: document.getElementById('OrderCountry').value.trim()
    } : null;

    const requiresInvoice = document.querySelector('input[name="requires_invoice"]:checked')?.value === 'yes';
    const fiscalData = requiresInvoice ? {
      requiresInvoice: true,
      rfc: extractedFiscalData?.rfc,
      fiscalName: extractedFiscalData?.fiscalName,
      fiscalCFDI: document.getElementById('FiscalCFDI').value,
      fiscalEmail: document.getElementById('FiscalEmail').value.trim()
    } : { requiresInvoice: false };

    // Envío de la información al Cloudflare Worker / Backend
    const workerResponse = await fetch(CONFIG.WORKER_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ cart: draftCart, orderType, shipping: shippingData || {}, fiscal: fiscalData })
    });

    if (!workerResponse.ok) throw new Error('Error al procesar la solicitud con el servidor backend.');
    const workerData = await workerResponse.json();
    if (!workerData.ok) throw new Error(workerData.error || 'No se pudo crear la orden en borrador.');

    const draftOrder = workerData.draftOrder;

    // Construcción del mensaje para WhatsApp
    let msg = `Hola, me gustaría realizar la siguiente orden:\n\n`;
    msg += `📋 *ORDEN REF:* ${draftOrder.name}\n`;
    msg += `🚚 *MODALIDAD:* ${orderType === 'shipping' ? 'Cotizar Envío' : 'Retiro en Tienda'}\n\n`;
    msg += `🛍️ *PRODUCTOS:*\n`;
    cart.items.forEach(item => {
      msg += `• item.producttitlex{item.quantity} - ${formatMoney(item.final_line_price)}\n`;
    });
    msg += `\n💰 *TOTAL:* ${formatMoney(cart.total_price)}\n\n`;

    if (shippingData) {
      msg += `📦 *ENVÍO:* ${shippingData.fullName}, shippingData.street#{shippingData.exteriorNumber}, ${shippingData.colonia}, ${shippingData.postalCode}, ${shippingData.state}\n\n`;
    }

    msg += `🧾 *FACTURA:* ${requiresInvoice ? 'Sí' : 'No'}\n`;

    const waURL = `https://wa.me/CONFIG.WHATSAPPNUMBER?text={encodeURIComponent(msg)}`;
    window.location.href = waURL;
  }

  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      if (!form.checkValidity()) { form.reportValidity(); return; }

      submitButton.disabled = true;
      submitButton.textContent = 'PROCESANDO...';

      try {
        await sendToWhatsApp();
        closeOrderModal();
      } catch (err) {
        showError(err.message || 'Error al procesar el pedido.');
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'CONTINUAR POR WHATSAPP';
      }
    });
  }
});
</script>

